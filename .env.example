# Use db:bootstrap for generated local-only values. Never use migration credentials in request code.
DATABASE_URL=postgresql://libetario_runtime:REPLACE_ME@127.0.0.1:55432/libetario
AUTH_DATABASE_URL=postgresql://libetario_auth:REPLACE_ME@127.0.0.1:55432/libetario
MIGRATION_DATABASE_URL=postgresql://libetario_migrator:REPLACE_ME@127.0.0.1:55432/libetario
APP_ORIGIN=http://127.0.0.1:3000
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
TRUST_PROXY=false
MFA_ACTIVE_KEY_ID=REPLACE_WITH_KEY_ID
# JSON mapping IDs to base64-encoded 32-byte keys. Generate locally with mfa:init-keys.
MFA_ENCRYPTION_KEYS='{"REPLACE_WITH_KEY_ID":"REPLACE_WITH_BASE64_32_BYTE_KEY"}'
# Back up the MFA keyring separately from the database. Do not lose old rotation keys.
# Production requires HTTPS, a dedicated DB, TLS appropriate to provider, and strong secrets.
# Generate/bind with uploads:init-keys after migrations/seed. Never put real values in Git.
UPLOAD_VALIDATION_KEY=REPLACE_WITH_32_RANDOM_BYTES_AS_64_HEX
PRIVATE_UPLOAD_ROOT=C:/absolute/private/path/outside/public
