generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model audit_log {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_user_id String?   @db.Uuid
  session_id    String?   @db.Uuid
  action        String
  occurred_at   DateTime  @default(now()) @db.Timestamptz(6)
  request_id    String
  payload       Json
  users         users?    @relation(fields: [actor_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sessions      sessions? @relation(fields: [session_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([actor_user_id, occurred_at])
  @@index([session_id])
}

model auth_events {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String?   @db.Uuid
  session_id     String?   @db.Uuid
  event_type     String
  outcome        String
  subject_digest String?
  network_digest String?
  occurred_at    DateTime  @default(now()) @db.Timestamptz(6)
  metadata       Json      @default("{}")
  sessions       sessions? @relation(fields: [session_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  users          users?    @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([session_id])
  @@index([user_id, occurred_at])
}

