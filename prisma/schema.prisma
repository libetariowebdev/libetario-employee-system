  @@index([revoked_by])
  @@index([work_policy_id])
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
}

enum RateBasis {
  DAILY
  HOURLY
}

enum Role {
  ADMINISTRATOR
  EMPLOYEE
}
