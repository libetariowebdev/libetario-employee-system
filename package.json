{
  "name": "libetario-workforce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/unit/*.test.ts tests/integration/*.test.ts tests/checkpoint/*.test.ts",
    "test:rls": "node --conditions=react-server --import tsx --test tests/checkpoint/rls.test.ts",
    "db:local": "tsx scripts/local-db.ts",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:replay-check": "tsx scripts/replay-migrations.ts",
    "mfa:init-keys": "tsx scripts/init-mfa-keys.ts",
    "mfa:reset-admin": "tsx scripts/reset-admin-mfa.ts",
    "mfa:rotate-keys": "tsx scripts/rotate-mfa-keys.ts",
    "test:http": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/e2e/*.test.ts",
    "test:all:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-all-win.ps1",
    "uploads:init-keys": "tsx scripts/init-upload-keys.ts",
    "uploads:cleanup": "node --conditions=react-server --import tsx scripts/cleanup-uploads.ts",
    "attendance:reconcile": "tsx scripts/reconcile-attendance.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "otpauth": "^9.5.2",
    "pdf-lib": "1.17.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
